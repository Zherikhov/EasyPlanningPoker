{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "packages": {
    "node": "24",
    "java": "21",
    "maven": "3.9.11"
  },
  "caches": {
    "npm-cache": {
      "directory": "/root/.npm",
      "type": "shared"
    },
    "maven-cache": {
      "directory": "/root/.m2",
      "type": "shared"
    }
  },
  "steps": {
    "frontend-install": {
      "commands": [
        "cd frontend && npm install"
      ],
      "caches": ["npm-cache"]
    },
    "frontend-build": {
      "inputs": [
        { "step": "frontend-install" }
      ],
      "commands": [
        "cd frontend && npm run build"
      ]
    },
    "copy-frontend-assets": {
      "inputs": [
        { "step": "frontend-build" }
      ],
      "commands": [

        { "src": "frontend/dist", "dest": "src/main/resources/static" }
      ]
    },
    "backend-build": {
      "inputs": [
        { "step": "copy-frontend-assets" }
      ],
      "commands": [
        "mvn clean package -DskipTests"
      ],
      "caches": ["maven-cache"],
      "deployOutputs": [
        "target/*.jar"
      ]
    }
  },
  "deploy": {
    "startCommand": "java -jar target/*.jar"
  }
}
