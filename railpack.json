{
  "$schema": "https://schema.railpack.com",
  "packages": { "node": "24", "java": "21", "maven": "3.9.11" },

  "caches": {
    "npm":   { "directory": "/root/.npm",           "type": "shared" },
    "maven": { "directory": "/root/.m2/repository", "type": "shared" }
  },

  "steps": {
    "install": {
      "inputs": [ { "include": [ "." ] } ],
      "commands": [
        "PATH:/mise/shims",
        "cd frontend && npm ci --include=dev",
        "PATH:frontend/node_modules/.bin"
      ],
      "caches": ["npm"]
    },

    "build-frontend": {
      "inputs": [ "install" ],
      "commands": [
        "cd frontend && npm run build",
        "rm -rf src/main/resources/static/* || true",
        "mkdir -p src/main/resources/static",
        "cp -r frontend/dist/* src/main/resources/static/"
      ]
    },

    "build-backend": {
      "inputs": [ "build-frontend" ],
      "commands": [ "PATH:/mise/shims", "mvn -DskipTests clean package" ],
      "caches": ["maven"],
      "deployOutputs": [
        { "include": ["target/*.jar", "src/main/resources/static/**"] }
      ]
    }
  },

  "deploy": {
    "inputs": [ "build-backend" ],
    "startCommand": "PATH:/mise/shims && java -Dserver.port=$PORT -jar target/*jar"
  }
}
