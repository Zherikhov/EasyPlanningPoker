{
  "$schema": "https://schema.railpack.com",
  "packages": { "node": "24", "java": "21", "maven": "3.9.11" },

  "caches": {
    "npm":   { "directory": "/root/.npm",           "type": "shared" },
    "maven": { "directory": "/root/.m2/repository", "type": "shared" }
  },

  "steps": {
    "install-frontend": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true }
      ],
      "commands": [
        "cd frontend && npm ci --include=dev",
        "PATH:frontend/node_modules/.bin"
      ],
      "caches": ["npm"]
    },

    "build-frontend": {
      "inputs": [ { "step": "install-frontend" } ],
      "commands": [
        "cd frontend && npm run build",
        "rm -rf src/main/resources/static/* || true",
        "mkdir -p src/main/resources/static",
        "cp -r frontend/dist/* src/main/resources/static/"
      ]
    },

    "build-backend": {
      "inputs": [ { "step": "build-frontend" } ],
      "commands": [
        "mvn -DskipTests clean package"
      ],
      "caches": ["maven"]
    }
  },

  "deploy": {
    "inputs": [
      { "step": "packages:mise" },
      { "step": "build-backend" }
    ],
    "startCommand": "java -Dserver.port=$PORT -jar target/*jar"
  }
}
