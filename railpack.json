{
  "$schema": "https://schema.railpack.com",
  "packages": { "node": "24", "java": "21", "maven": "3.9.11" },

  "env": { "PATH": "/mise/shims:$PATH" },

  "caches": {
    "npm":   { "directory": "/root/.npm",           "type": "shared" },
    "maven": { "directory": "/root/.m2/repository", "type": "shared" }
  },

  "steps": {
    "install": {
      "commands": [
        "COPY:./ ./",
        "cd frontend && /mise/shims/npm ci --include=dev"
      ],
      "caches": ["npm"]
    },

    "build-frontend": {
      "inputs": ["install"],
      "commands": [
        "cd frontend && /mise/shims/npm run build",
        "rm -rf src/main/resources/static/* || true",
        "mkdir -p src/main/resources/static",
        "cp -r frontend/dist/* src/main/resources/static/"
      ]
    },

    "build-backend": {
      "inputs": ["build-frontend"],
      "commands": [
        "/mise/shims/mvn -DskipTests clean package"
      ],
      "caches": ["maven"]
    }
  },

  "deploy": {
    "base": { "image": "ghcr.io/railwayapp/railpack-runtime:latest" },
    "inputs": ["build-backend"],
    "startCommand": "/mise/shims/java -Dserver.port=$PORT -jar target/*jar"
  }
}
