{
  "$schema": "https://schema.railpack.com",
  "packages": { "node": "24", "java": "21", "maven": "3.9.11" },
  "caches": {
    "npm":   { "directory": "/root/.npm",           "type": "shared" },
    "maven": { "directory": "/root/.m2/repository", "type": "shared" }
  },
  "steps": {
    "install": {
      "commands": [
        { "src": ".", "dest": "." },
        { "cmd": "bash -lc \"cd frontend && npm ci --include=dev\"" },
        { "path": "frontend/node_modules/.bin" }
      ],
      "caches": ["npm"]
    },
    "build-frontend": {
      "inputs": [ { "step": "install" } ],
      "commands": [
        { "cmd": "bash -lc \"cd frontend && npm run build\"" },
        { "cmd": "rm -rf src/main/resources/static/* || true" },
        { "cmd": "mkdir -p src/main/resources/static" },
        { "cmd": "cp -r frontend/dist/* src/main/resources/static/" }
      ]
    },
    "build-backend": {
      "inputs": [ { "step": "build-frontend" } ],
      "commands": [ { "cmd": "mvn -DskipTests clean package" } ],
      "caches": ["maven"],
      "deployOutputs": [ { "include": ["target/*.jar"] } ]
    }
  },
  "deploy": {
    "base": { "image": "ghcr.io/railwayapp/railpack-runtime:latest" },
    "paths": [ "/mise/shims" ],
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      { "step": "build-backend" }
    ],
    "startCommand": "java -Dserver.port=$PORT -jar target/*jar"
  }
}
